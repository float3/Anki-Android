<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ankiquest_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/ankiquest_screen_title"
            android:shadowColor="#B3000000"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="@color/ankiquest_widget_clear_text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="@string/ankiquest_widget_this_week"
            android:shadowColor="#B3000000"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="@color/ankiquest_widget_clear_text_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ankiquest_widget_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#B3000000"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="@color/ankiquest_widget_clear_text_dim"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/ankiquest_widget_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/ankiquest_widget_refresh"
            android:padding="7dp"
            android:src="@drawable/ankiquest_widget_refresh_clear" />
    </LinearLayout>

    <TextView
        android:id="@+id/ankiquest_widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingTop="6dp"
        android:shadowColor="#B3000000"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/ankiquest_widget_clear_text"
        android:textSize="13sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/ankiquest_widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="2dp"
        android:fadeScrollbars="false"
        android:scrollbars="vertical"
        android:visibility="gone" />
</LinearLayout>
